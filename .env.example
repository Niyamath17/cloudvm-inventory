# Root environment file read automatically by `docker compose`.
# Copy to .env:   cp .env.example .env
# NEVER commit .env – it is git-ignored.

POSTGRES_USER=cloudvm
POSTGRES_PASSWORD=cloudvm_dev_password
POSTGRES_DB=cloudvm
# Host port Postgres is published on. Change if 5432 is already used on your Mac.
POSTGRES_PORT=5432
