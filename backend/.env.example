# CloudVM backend configuration
# Copy to backend/.env and adjust:   cp backend/.env.example backend/.env
# NEVER commit backend/.env – it is git-ignored.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Must match the POSTGRES_* values in the root .env used by docker-compose
DATABASE_URL=postgresql://cloudvm:cloudvm_dev_password@localhost:5432/cloudvm?schema=public

# --- NetBox -----------------------------------------------------------------
# simulation = clearly-labelled local stand-in, NO real NetBox calls (default)
# live       = real NetBox REST API (requires NETBOX_URL and NETBOX_TOKEN)
NETBOX_MODE=simulation
NETBOX_URL=
NETBOX_TOKEN=
# Token  -> header "Authorization: Token <token>"           (NetBox < 4.5 / v1 tokens)
# Bearer -> header "Authorization: Bearer nbt_<key>.<token>" (NetBox >= 4.5 v2 tokens)
NETBOX_AUTH_SCHEME=Token

# --- Scheduler (used from milestone M6) ----------------------------------------
SCHEDULER_ENABLED=false
COLLECTION_CRON=*/15 * * * *
