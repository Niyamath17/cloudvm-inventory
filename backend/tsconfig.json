{
  // Base config used by the editor, `npm run typecheck` and tests.
  // `tsconfig.build.json` extends this and emits only src/ to dist/.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],

    // --- Strictness (project requirement: TypeScript strict mode) ---
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["src", "tests", "scripts", "vitest.config.ts"]
}
